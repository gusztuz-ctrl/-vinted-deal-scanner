import streamlit as st
import pandas as pd
from pathlib import Path

st.set_page_config(page_title="Vinted Resale Scanner", page_icon="🔎", layout="wide")

BRAND_MULTIPLIERS = {
    "nike": 1.45, "adidas": 1.35, "carhartt": 1.55, "ralph lauren": 1.5,
    "burberry": 1.8, "stone island": 1.8, "the north face": 1.5,
    "patagonia": 1.45, "levis": 1.25, "polo": 1.25
}
COND_MULT = {"new": 1.25, "new without tags": 1.2, "very good": 1.05, "good": 0.9, "satisfactory": 0.75}

def estimate_resale(row):
    price = float(row.get("price_huf", 0) or 0)
    brand = str(row.get("brand", "")).lower()
    cond = str(row.get("condition", "")).lower()
    mult = BRAND_MULTIPLIERS.get(brand, 1.0)
    cm = next((v for k, v in COND_MULT.items() if k in cond), 0.85)
    # Conservative estimate; user can change the formula for their own market.
    return round(price * mult * cm * 1.8 / 100) * 100

def score(row):
    buy = float(row.get("price_huf", 0) or 0)
    resale = estimate_resale(row)
    profit = resale - buy
    roi = (profit / buy * 100) if buy else 0
    return max(0, round(min(100, roi * 0.65 + (profit / 100) * 0.25), 1))

st.title("🔎 Vinted Resale Scanner")
st.caption("Starter scanner for your own listing data. No scraping or anti-bot bypass is included.")

uploaded = st.file_uploader("Upload listings CSV", type=["csv"])
if uploaded:
    df = pd.read_csv(uploaded)
else:
    sample = Path("data/listings.csv")
    if sample.exists():
        df = pd.read_csv(sample)
    else:
        df = pd.DataFrame(columns=["title","brand","size","condition","price_huf","category","url"])

if df.empty:
st.info("Upload a CSV with listing data to start.")
    st.stop()

required = ["title", "brand", "condition", "price_huf"]
missing = [c for c in required if c not in df.columns]
if missing:
    st.error(f"Missing columns: {', '.join(missing)}")
    st.stop()

df["price_huf"] = pd.to_numeric(df["price_huf"], errors="coerce").fillna(0)
df["estimated_resale_huf"] = df.apply(estimate_resale, axis=1)
df["estimated_profit_huf"] = df["estimated_resale_huf"] - df["price_huf"]
df["roi_pct"] = (df["estimated_profit_huf"] / df["price_huf"].replace(0, pd.NA) * 100).fillna(0).round(1)
col1, col2, col3 = st.columns(3)
with col1:
    max_price = st.number_input("Max buy price (Ft)", min_value=0, value=10000, step=500)
with col2:
    min_profit = st.number_input("Min estimated profit (Ft)", min_value=0, value=3000, step=500)
with col3:
    min_score = st.slider("Min score", 0, 100, 40)

result = df[(df.price_huf <= max_price) & (df.estimated_profit_huf >= min_profit) & (df.score >= min_score)].copy()
result = result.sort_values(["score", "estimated_profit_huf"], ascending=False)

st.subheader(f"Potential opportunities: {len(result)}")
show_cols = [c for c in ["score","title","brand","size","condition","price_huf","estimated_resale_huf","estimated_profit_huf","roi_pct","category","url"] if c in result.columns]
st.dataframe(result[show_cols], use_container_width=True, hide_index=True)

st.download_button("Download results CSV", result.to_csv(index=False).encode("utf-8"), "scanner_results.csv", "text/csv")
